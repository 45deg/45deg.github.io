{% macro workCard(work, featured=false, lazy=false) %}
{% set size = work | workSize %}
<article class="card size-{{ size }}{% if featured %} is-featured{% endif %}" data-tags="{{ work.tags | join(',') }}" data-featured="{{ 'true' if featured else 'false' }}" data-size="{{ size }}">
    <a class="card-link" href="{{ work.href | locale(lang) | localPath(lang) }}" aria-label="{{ work.title | locale(lang) }}">
        <span class="visually-hidden">{{ work.title | locale(lang) }}</span>
    </a>
    <div class="card-img-wrapper">
        {% if work.image %}
        <img src="{{ work.image.src | localPath(lang) }}" alt="{{ work.image.alt | locale(lang) }}" width="512" height="320"{% if lazy %} loading="lazy"{% endif %} decoding="async">
        {% else %}
        <div class="placeholder-img {{ work.placeholder.class }}" data-emoji="{{ work.placeholder.emoji }}"></div>
        {% endif %}
    </div>
    <div class="card-content">
        <h3 class="card-title"><strong>{{ work.title | locale(lang) }}</strong> <span class="text-muted">({{ work.year }})</span></h3>
        <p class="card-desc">{{ work.description_html | locale(lang) | safe }}</p>
        <div class="card-tags" aria-label="{{ 'タグ' if lang == 'ja' else 'Tags' }}">
            {% if featured %}<span class="featured-tag">Featured</span>{% endif %}
            {% for tag in work.tags %}<span>{{ tag }}</span>{% endfor %}
        </div>
    </div>
</article>
{% endmacro %}
<!DOCTYPE html>
<html lang="{{ lang }}">

<head>
    {% set siteUrl = homepage.site_url %}
    {% set siteName = homepage.title %}
    {% set pageTitle = homepage.seo_title | locale(lang) %}
    {% set pageDescription = homepage.description | locale(lang) %}
    {% set canonicalPath = "/" if lang == "ja" else "/index_en.html" %}
    {% set canonicalUrl = canonicalPath | absoluteUrl(siteUrl) %}
    {% set alternateJaUrl = "/" | absoluteUrl(siteUrl) %}
    {% set alternateEnUrl = "/index_en.html" | absoluteUrl(siteUrl) %}
    {% set ogImageUrl = homepage.og_image | absoluteUrl(siteUrl) %}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ canonicalUrl }}">
    <link rel="alternate" hreflang="ja" href="{{ alternateJaUrl }}">
    <link rel="alternate" hreflang="en" href="{{ alternateEnUrl }}">
    <link rel="alternate" hreflang="x-default" href="{{ alternateJaUrl }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ siteName }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:url" content="{{ canonicalUrl }}">
    <meta property="og:image" content="{{ ogImageUrl }}">
    <meta property="og:locale" content="{{ 'ja_JP' if lang == 'ja' else 'en_US' }}">
    <meta property="og:locale:alternate" content="{{ 'en_US' if lang == 'ja' else 'ja_JP' }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ ogImageUrl }}">
    <link rel="stylesheet" href="{{ './style.css' | localPath(lang) }}">
    <script type="application/ld+json">
        {{ {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": siteName,
            "url": canonicalUrl,
            "description": pageDescription,
            "inLanguage": lang,
            "author": {
                "@type": "Person",
                "name": "zakuro",
                "url": homepage.profile_url
            }
        } | json | safe }}
    </script>
</head>

<body>
    <header>
        <h1>{{ homepage.title }}</h1>
        <p class="about-summary">{{ homepage.about | locale(lang) }} <a href="{{ homepage.github_url }}">GitHub</a> <a href="{{ homepage.profile_url }}">X</a></p>
        <nav class="language-switch" aria-label="Language">
            {% if lang == "ja" %}
            <a class="is-active" href="./" aria-current="page">日本語</a>
            <a href="{{ alternateUrl }}">English</a>
            {% else %}
            <a href="{{ alternateUrl }}">日本語</a>
            <a class="is-active" href="./index_en.html" aria-current="page">English</a>
            {% endif %}
        </nav>
    </header>

    <div class="page-flow">
        <main class="main">
            <section>
                <h2>Works</h2>
                <div class="work-filters" id="work-filter-tags" aria-label="{{ 'カテゴリで絞り込む' if lang == 'ja' else 'Filter by category' }}">
                    {% for filter in homepage.filters %}
                    <button class="tag-filter{% if filter.featuredOnly %} featured-filter{% endif %}{% if loop.first %} is-active{% endif %}" type="button" data-filter="{{ filter.key }}" data-filter-tags="{{ filter.tags | join(',') }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ filter.label | locale(lang) }} <span>({{ homepage.works | countByFilter(filter) }})</span></button>
                    {% endfor %}
                </div>
                <div class="works-grid" id="works-grid">
                    {% for work in homepage.works %}{{ workCard(work, work.featured, loop.index > 4) }}{% endfor %}
                </div>
            </section>
        </main>
    </div>

    <script>
        (() => {
            const filterRoot = document.querySelector("#work-filter-tags");
            const cards = [...document.querySelectorAll("#works-grid .card")];
            if (!filterRoot || !cards.length) return;

            const filterButtons = [...filterRoot.querySelectorAll("[data-filter]")];
            const sizeClasses = ["size-large", "size-medium", "size-small"];
            const mqTablet = window.matchMedia("(max-width: 960px)");
            const mqMobile = window.matchMedia("(max-width: 600px)");

            const setCardSizeClass = (card, targetSize) => {
                for (const cls of sizeClasses) {
                    card.classList.toggle(cls, cls === `size-${targetSize}`);
                }
            };

            const getSpan = (size) => {
                if (size === "large") return { w: 2, h: 3 };
                if (size === "medium") return { w: 1, h: 2 };
                return { w: 1, h: 1 };
            };

            const packCards = (items, cols) => {
                const queue = items.map((item) => ({ ...item }));
                const heights = new Array(cols).fill(0);
                const placements = [];
                let lastLargePair = -1;

                while (queue.length > 0) {
                    const minH = Math.min(...heights);
                    const maxH = Math.max(...heights);
                    const pairs = [];
                    for (let p = 0; p < cols; p += 2) {
                        if (heights[p] === minH && heights[p + 1] === minH) {
                            pairs.push(p);
                        }
                    }

                    if (pairs.length > 0) {
                        let pairCol = pairs[0];
                        if (pairs.length > 1 && pairs[0] === lastLargePair) {
                            pairCol = pairs[1];
                        }

                        const otherPairCol = cols === 4 ? (pairCol === 0 ? 2 : 0) : -1;
                        const otherPairHasLargeAtSameTop = otherPairCol !== -1 && placements.some(
                            (pl) => pl.col === otherPairCol && pl.row === minH && pl.w === 2
                        );

                        const remainingOneColCells = queue
                            .filter((it) => it.size !== "large")
                            .reduce((sum, it) => sum + getSpan(it.size).h, 0);
                        const firstLargeIdx = queue.findIndex((it) => it.size === "large");
                        const otherPairDeficitIfLargePlaced = cols === 4
                            ? Math.max(0, (minH + 3) - heights[otherPairCol]) + Math.max(0, (minH + 3) - heights[otherPairCol + 1])
                            : 0;
                        const pairDeficit = maxH - minH;

                        let chosenIdx = -1;
                        if (firstLargeIdx !== -1 && cols === 4 && remainingOneColCells <= otherPairDeficitIfLargePlaced) {
                            chosenIdx = firstLargeIdx;
                        } else if (queue[0].size === "large" && !otherPairHasLargeAtSameTop) {
                            chosenIdx = 0;
                        } else if (queue[0].size === "large" && otherPairHasLargeAtSameTop) {
                            const oneColIdx = queue.findIndex((it, i) => i < 6 && it.size !== "large");
                            chosenIdx = oneColIdx !== -1 ? oneColIdx : 0;
                        } else {
                            const remainingOneColCount = queue.filter((it) => it.size !== "large").length;
                            if (remainingOneColCount === 1 && queue.length > 1 && firstLargeIdx !== -1) {
                                chosenIdx = firstLargeIdx;
                            } else if (pairDeficit > 0 && queue.length <= 6) {
                                const matchIdx = queue.findIndex((it) => it.size !== "large" && getSpan(it.size).h === pairDeficit);
                                chosenIdx = matchIdx !== -1 ? matchIdx : 0;
                            } else {
                                chosenIdx = 0;
                            }
                        }

                        const item = queue.splice(chosenIdx, 1)[0];
                        const span = getSpan(item.size);
                        if (span.w === 2) {
                            placements.push({ item, col: pairCol, row: minH, w: 2, h: 3, effectiveSize: "large" });
                            heights[pairCol] += 3;
                            heights[pairCol + 1] += 3;
                            lastLargePair = pairCol;
                        } else {
                            placements.push({ item, col: pairCol, row: minH, w: 1, h: span.h, effectiveSize: item.size });
                            heights[pairCol] += span.h;
                        }
                    } else {
                        const minCol = heights.indexOf(minH);
                        const partnerCol = minCol % 2 === 0 ? minCol + 1 : minCol - 1;
                        const delta = heights[partnerCol] - heights[minCol];

                        const remainingOneCols = queue
                            .map((it, idx) => ({ it, idx }))
                            .filter((entry) => entry.it.size !== "large");

                        if (remainingOneCols.length === 0) {
                            const item = queue.splice(0, 1)[0];
                            const effSize = delta === 1 ? "small" : "medium";
                            const h = effSize === "small" ? 1 : 2;
                            placements.push({ item, col: minCol, row: minH, w: 1, h, effectiveSize: effSize });
                            heights[minCol] += h;
                            continue;
                        }

                        const exactMatch = remainingOneCols.find((entry) => entry.idx < 8 && getSpan(entry.it.size).h === delta);
                        const chosenIdx = exactMatch ? exactMatch.idx : remainingOneCols[0].idx;
                        const item = queue.splice(chosenIdx, 1)[0];

                        let effSize = item.size;
                        let h = getSpan(effSize).h;
                        if (remainingOneCols.length === 1 && queue.some((it) => it.size === "large") && (delta === 1 || delta === 2)) {
                            effSize = delta === 1 ? "small" : "medium";
                            h = delta;
                        }
                        placements.push({ item, col: minCol, row: minH, w: 1, h, effectiveSize: effSize });
                        heights[minCol] += h;
                    }
                }

                return placements;
            };

            const layoutGrid = () => {
                const cols = mqMobile.matches ? 1 : mqTablet.matches ? 2 : 4;
                if (cols === 1) {
                    for (const card of cards) {
                        card.style.gridColumn = "";
                        card.style.gridRow = "";
                        setCardSizeClass(card, card.dataset.size || "medium");
                    }
                    return;
                }

                const visibleItems = [];
                for (const card of cards) {
                    if (card.hidden) {
                        card.style.gridColumn = "";
                        card.style.gridRow = "";
                        setCardSizeClass(card, card.dataset.size || "medium");
                    } else {
                        visibleItems.push({ card, size: card.dataset.size || "medium" });
                    }
                }

                const placements = packCards(visibleItems, cols);
                for (const pl of placements) {
                    pl.item.card.style.gridColumn = `${pl.col + 1} / span ${pl.w}`;
                    pl.item.card.style.gridRow = `${pl.row + 1} / span ${pl.h}`;
                    setCardSizeClass(pl.item.card, pl.effectiveSize);
                }
            };

            const applyFilter = (filterButton) => {
                const key = filterButton.dataset.filter;
                const filterTags = filterButton.dataset.filterTags.split(",").filter(Boolean);

                for (const card of cards) {
                    const tags = card.dataset.tags.split(",").filter(Boolean);
                    const matchesFeatured = key === "featured" && card.dataset.featured === "true";
                    const matchesTags = filterTags.some((tag) => tags.includes(tag));
                    card.hidden = key !== "all" && !matchesFeatured && !matchesTags;
                }

                for (const button of filterButtons) {
                    const isActive = button === filterButton;
                    button.classList.toggle("is-active", isActive);
                    button.setAttribute("aria-pressed", String(isActive));
                }

                layoutGrid();
            };

            filterRoot.addEventListener("click", (event) => {
                const filterButton = event.target.closest("[data-filter]");
                if (!filterButton) return;
                applyFilter(filterButton);
            });

            mqTablet.addEventListener("change", layoutGrid);
            mqMobile.addEventListener("change", layoutGrid);
            layoutGrid();
        })();
    </script>
</body>

</html>
